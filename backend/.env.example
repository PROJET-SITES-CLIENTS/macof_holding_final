# Chaine de connexion PostgreSQL (ex: postgresql://user:password@host:5432/dbname?sslmode=require)
DATABASE_URL=

# Secret de signature des JWT - min 32 caracteres (ex: changer-cette-chaine-aleatoire-de-32-chars-minimum)
JWT_SECRET=

# Token Vercel Blob pour le stockage des fichiers (ex: vercel_blob_rw_...)
BLOB_READ_WRITE_TOKEN=

# Cle API Google Gemini pour le chatbot vocal (ex: AIza...)
GEMINI_API_KEY=

# Mot de passe SMTP pour l'envoi d'emails (ex: mot-de-passe-application)
SMTP_PASSWORD=

# Secret client pour les webhooks Djomy (ex: djomy_secret_...)
DJOMY_CLIENT_SECRET=

# Identifiants de l'admin crees au seeding (ex: admin@exemple.com / MotDePasseFort123!)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Port d'ecoute du serveur (ex: 3000)
PORT=

# Environnement d'execution : development | production | test
NODE_ENV=
