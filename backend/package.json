{
  "name": "api-macof",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "vercel-build": "esbuild scripts/bundle-entry.ts --bundle --platform=node --target=node26 --format=esm --outfile=api/index.mjs --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "dev": "npx tsx --dns-result-order=ipv4first src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "npx tsx src/db/seed.ts",
    "db:seed-menu": "npx tsx src/db/seed-menu.ts"
  },
  "keywords": [],
  "author": "MACOF Holding",
  "license": "ISC",
  "description": "MACOF Holding API - Backend Serverless",
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@hono/node-server": "^2.0.12",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.33",
    "jose": "^6.2.5",
    "nodemailer": "^9.0.5",
    "web-push": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.10",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
